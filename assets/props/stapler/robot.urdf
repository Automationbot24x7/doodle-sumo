<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="top_arm">
    <visual>
      <geometry>
        <mesh filename="meshes/top_arm.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="top_arm_joint" type="revolute">
    <parent link="base" />
    <child link="top_arm" />
    <origin rpy="0 0 0" xyz="0.03505200 0.02550709 -0.00011000" />
    <axis xyz="0.00739700 -0.00432700 -0.99996300" />
    <limit lower="0.000000" upper="0.698000" effort="10" velocity="1" />
  </joint>
</robot>