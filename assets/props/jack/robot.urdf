<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="lid">
    <visual>
      <geometry>
        <mesh filename="meshes/lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="crank">
    <visual>
      <geometry>
        <mesh filename="meshes/crank.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="lid_joint" type="revolute">
    <parent link="base" />
    <child link="lid" />
    <origin rpy="0 0 0" xyz="-0.01335100 0.12009700 -0.06055900" />
    <axis xyz="-0.99989700 -0.00594700 -0.01303200" />
    <limit lower="0.000000" upper="1.920000" effort="10" velocity="1" />
  </joint>
  <joint name="crank_joint" type="continuous">
    <parent link="base" />
    <child link="crank" />
    <origin rpy="0 0 0" xyz="0.05130000 0.06480000 0.03790000" />
    <axis xyz="1.00000000 0.00000000 0.00000000" />
  </joint>
</robot>