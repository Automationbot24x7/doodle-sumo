<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="rotor">
    <visual>
      <geometry>
        <mesh filename="meshes/rotor.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="rotor_joint" type="continuous">
    <parent link="base" />
    <child link="rotor" />
    <origin rpy="0 0 0" xyz="-0.02839100 0.15920500 0.05775400" />
    <axis xyz="0.00000000 0.00000000 1.00000000" />
  </joint>
</robot>